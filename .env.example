# ---- Server ----
PORT=8787
# The public URL people open the app at (used for Strava OAuth redirects and cookies).
APP_URL=http://localhost:8787
# Random 32+ char string. Signs session cookies. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite file lives. Mount a volume here in production.
DATABASE_PATH=./data/logbook.db
# Set to 1 to allow creating the first account from the web UI (turn off after you sign up).
ALLOW_SETUP=1

# ---- Claude (plan builder + coach's read) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Strava (https://www.strava.com/settings/api) ----
# Authorization Callback Domain must match APP_URL's host, e.g. localhost or logbook.yourdomain.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when verifying the webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=logbook-verify

# ---- Athlete context given to Claude when it writes plans and notes ----
ATHLETE_CONTEXT="Josh, 27, Brooklyn. Endurance runner (marathon background, Hyrox-style racing) who also lifts for a lean, defined look, 45-60 min sessions. Investment banking associate: long, unpredictable days, so early mornings are the most reliable training window and weekdays must be short."
