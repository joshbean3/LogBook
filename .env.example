# ---- Server ----
PORT=8787
# The public URL people open the app at (emailed links, cookies, Strava's redirect).
APP_URL=http://localhost:8787
# Random 32+ char string. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite file lives. Mount a volume here in production.
DATABASE_PATH=./data/logbook.db
# 1 lets anyone create an account (a public server; local development too).
ALLOW_SIGNUP=1
# 1 lets only the first visitor create the one account (a private server). Not needed with ALLOW_SIGNUP=1.
ALLOW_SETUP=1

# Extra origins allowed to send writes, comma separated. The app's own origin (APP_URL) and the iPhone app are always allowed.
ALLOWED_ORIGINS=
# Your Apple developer team id (10 characters). With it the server answers /.well-known/apple-app-site-association,
# so iOS can save and fill the Logbook password in the app.
APPLE_TEAM_ID=
# Compiled into the web app at build time (docker build args; `pnpm build` reads them from the environment):
# the support address people can write to, and where the legal pages live when that is not this server.
VITE_SUPPORT_EMAIL=
VITE_SITE_ORIGIN=

# ---- Mail (password reset, email verification) ----
# Without a key the server logs the message, link included, so you can walk the flow locally.
MAIL_API_KEY=
# The From line, on a domain the mail provider has verified.
MAIL_FROM="Logbook <no-reply@example.com>"

# ---- Nightly off-site backup (apps/api/RUNBOOK.md). Off unless the first four are set. ----
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Days a remote copy is kept. Keep this equal to the number the app and the privacy policy state.
BACKUP_KEEP_DAYS=5

# ---- Claude (the assistant, plan builder, goal review, Remember when, daily pick) ----
# Both are needed. With either one empty the AI features stay off.
ANTHROPIC_API_KEY=
# The id of the model to use, from the Anthropic Console.
ANTHROPIC_MODEL=
# Optional: a different model id for the assistant chat. Falls back to ANTHROPIC_MODEL.
ANTHROPIC_ASSISTANT_MODEL=

# ---- Strava (https://www.strava.com/settings/api) ----
# Authorization Callback Domain must match APP_URL's host, e.g. localhost or logbook.yourdomain.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# A long random string (`openssl rand -hex 24`); Strava echoes it back when the webhook subscription is created.
# There is no default, and production refuses to start with the Strava keys set and no real token.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# The id Strava returns for the webhook subscription. Events without it are refused.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# ---- App Review demo account (pnpm --filter @logbook/api seed:review, or node dist/ops.js seed-review) ----
# Not secrets in the repository: set them only when you run the command.
# REVIEW_EMAIL=review@your-domain
# REVIEW_PASSWORD=
