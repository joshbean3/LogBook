# ---- Server ----
PORT=8787
# The public URL people open the app at (used for Strava OAuth redirects and cookies).
APP_URL=http://localhost:8787
# Random 32+ char string. Signs session cookies. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite file lives. Mount a volume here in production.
DATABASE_PATH=./data/logbook.db
# Set to 1 to allow creating the first account from the web UI (turn off after you sign up).
ALLOW_SETUP=1

# ---- Claude (plan builder + coach's read) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Strava (https://www.strava.com/settings/api) ----
# Authorization Callback Domain must match APP_URL's host, e.g. localhost or logbook.yourdomain.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when verifying the webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=logbook-verify

# ---- COROS (through COROS's MCP server; nothing to register) ----
# The server discovers COROS's OAuth endpoints from the MCP URL and registers itself as a client on the first connect,
# against APP_URL (which has to be a public https URL). Only if COROS refuses that registration: a client registered by
# hand with APP_URL/api/connections/coros/callback as its redirect, and its secret if COROS issued one.
# COROS_MCP_URL=https://mcp.coros.com/mcp
# COROS_CLIENT_ID=
# COROS_CLIENT_SECRET=

# ---- Web Push (reminders). `npx web-push generate-vapid-keys` prints a pair. Unset: the scheduler logs instead of sending. ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# "About you, for the assistant" now lives on the account (Settings › You), not in the environment.

# ---- Ops (README: Observability, Backups, The worker process) ----
# Who runs the background jobs: inline (the API; the default), worker (node dist/worker.js), off.
RUN_JOBS=inline
# 0 skips the migrations at boot (then run `pnpm db:migrate` yourself).
RUN_MIGRATIONS=1
# debug | info | warn | error; json (production default) | pretty.
LOG_LEVEL=info
# LOG_FORMAT=json
# Sentry DSN: unset, errors are only logged.
SENTRY_DSN=
# When set, GET /api/metrics needs `Authorization: Bearer <token>`.
METRICS_TOKEN=
# Nightly `VACUUM INTO` copies: where (default: backups/ next to the database) and how many to keep.
# BACKUP_DIR=/data/backups
BACKUP_KEEP=7
# Litestream (continuous replication to S3-compatible storage; the Docker entrypoint reads these). Unset: off.
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Tigris: https://fly.storage.tigris.dev  ·  R2: https://<account>.r2.cloudflarestorage.com  ·  AWS: leave empty
LITESTREAM_REPLICA_ENDPOINT=

# ---- Email (verification links, password resets) through Resend (https://resend.com), plain HTTPS, no SDK ----
# Unset: every mail is printed to the server log instead of sent (and GET /api/auth/dev/last-mail shows the last one outside production).
RESEND_API_KEY=
# The From line, from a domain verified in Resend.
MAIL_FROM="Logbook <hello@yourdomain>"
