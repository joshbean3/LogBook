    "android": { "package": "com.joshbean.logbook", "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#000000" } },
    "extra": { "appUrl": "https://josh-logbook.fly.dev" }
  }
