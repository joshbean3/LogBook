<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of a training plan, a schedule or a list to send to the assistant or the plan builder.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a photo of a training plan, a schedule or a list to send to the assistant or the plan builder.</string>
